generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantRole {
  owner
  admin
  manager
  cashier
  kitchen

  @@map("restaurant_role")
}

enum OrderSource {
  pdv
  mesa
  delivery
  site
  ifood
  food99 @map("99food")
  keeta
  rappi
  manual

  @@map("order_source")
}

enum OrderType {
  dine_in
  delivery
  pickup

  @@map("order_type")
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  out_for_delivery
  completed
  canceled

  @@map("order_status")
}

enum PaymentStatus {
  pending
  paid
  refunded

  @@map("payment_status")
}

enum PaymentMethod {
  cash
  credit_card
  debit_card
  pix
  online
  other

  @@map("payment_method")
}

enum IntegrationProvider {
  NINETY_NINE_FOOD @map("99food")
  IFOOD            @map("ifood")
  KEETA            @map("keeta")
  WHATSAPP         @map("whatsapp")
  OWN_MENU         @map("own_menu")
  CUSTOM_WEBHOOK   @map("webhook")
  RAPPI            @map("rappi")

  @@map("integration_provider")
}

enum IntegrationStatus {
  DISCONNECTED @map("disconnected")
  PENDING      @map("pending")
  ACTIVE       @map("active")
  CONNECTED    @map("connected")
  ERROR        @map("error")
  DISABLED     @map("disabled")

  @@map("integration_status")
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

enum IntegrationAuthType {
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2
  WEBHOOK_ONLY
  MANUAL
}

enum ExternalOrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELED
  UNKNOWN
}

model Restaurant {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String           @map("owner_id") @db.Uuid
  name                  String
  slug                  String           @unique
  description           String?
  logoUrl               String?          @map("logo_url")
  bannerUrl             String?          @map("banner_url")
  coverUrl              String?          @map("cover_url")
  phone                 String?
  whatsapp              String?
  email                 String?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?          @map("zip_code")
  isOpen                Boolean          @default(true) @map("is_open")
  minimumOrder          Decimal          @default(0) @map("minimum_order") @db.Decimal(12, 2)
  deliveryFee           Decimal          @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  estimatedDeliveryTime String?          @map("estimated_delivery_time")
  menuFooterMessage     String?          @map("menu_footer_message")
  openingHours          Json             @default("{}") @map("opening_hours")
  deliveryEnabled       Boolean          @default(true) @map("delivery_enabled")
  pickupEnabled         Boolean          @default(true) @map("pickup_enabled")
  tableServiceEnabled   Boolean          @default(true) @map("table_service_enabled")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  categories            Category[]
  products              Product[]
  productTypes          ProductType[]
  addons                ProductAddon[]
  customers             Customer[]
  orders                Order[]
  users                 RestaurantUser[]
  integrations          Integration[]

  @@map("restaurants")
}

model ProductType {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String
  description  String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, name])
  @@map("product_types")
}

model RestaurantUser {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  role         RestaurantRole @default(cashier)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@map("restaurant_users")
}

model Category {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String
  description  String?
  sortOrder    Int        @default(0) @map("display_order")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@map("categories")
}

model Product {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String           @map("restaurant_id") @db.Uuid
  categoryId          String?          @map("category_id") @db.Uuid
  productTypeId       String?          @map("product_type_id") @db.Uuid
  name                String
  description         String?
  price               Decimal          @db.Decimal(12, 2)
  imageUrl            String?          @map("image_url")
  active              Boolean          @default(true)
  featured            Boolean          @default(false)
  preparationTime     Int?             @map("preparation_time")
  sortOrder           Int              @default(0) @map("sort_order")
  stockControlEnabled Boolean          @default(false) @map("stock_control_enabled")
  stockQuantity       Int?             @map("stock_quantity")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  restaurant          Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category            Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType         ProductType?     @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  orderItems          OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  price     Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductAddon {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String           @map("restaurant_id") @db.Uuid
  name         String
  price        Decimal          @db.Decimal(12, 2)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemAddons   OrderItemAddon[]

  @@map("product_addons")
}

model Customer {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?           @map("zip_code")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  orders       Order[]

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  street       String
  number       String?
  neighborhood String?
  complement   String?
  reference    String?
  city         String?
  state        String?
  zipCode      String?  @map("zip_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Order {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String        @map("restaurant_id") @db.Uuid
  customerId       String?       @map("customer_id") @db.Uuid
  code             String        @unique
  orderNumber      Int           @map("order_number")
  source           OrderSource   @default(manual)
  type             OrderType     @default(pickup)
  status           OrderStatus   @default(pending)
  paymentStatus    PaymentStatus @default(pending) @map("payment_status")
  paymentMethod    PaymentMethod @default(other) @map("payment_method")
  changeFor        Decimal?      @map("change_for") @db.Decimal(12, 2)
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee      Decimal       @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @default(0) @db.Decimal(12, 2)
  customerName     String?       @map("customer_name")
  customerPhone    String?       @map("customer_phone")
  deliveryAddress  String?       @map("delivery_address")
  tableId          String?       @map("table_id") @db.Uuid
  notes            String?
  externalOrderId  String?       @map("external_order_id")
  integrationId    String?       @map("integration_id") @db.Uuid
  externalOrderCode String?      @map("external_order_code")
  externalPlatform String?       @map("external_platform")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  integration      Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, orderNumber])
  @@map("orders")
}

model Integration {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String              @map("restaurant_id") @db.Uuid
  provider          IntegrationProvider
  name              String?
  status            IntegrationStatus   @default(DISCONNECTED)
  environment       String              @default("production")
  authType          String              @default("manual") @map("auth_type")
  externalStoreId   String?             @map("external_store_id")
  externalStoreName String?             @map("external_store_name")
  apiBaseUrl        String?             @map("api_base_url")
  clientId          String?             @map("client_id")
  clientSecret      String?             @map("client_secret")
  accessToken       String?             @map("access_token")
  refreshToken      String?             @map("refresh_token")
  apiKey            String?             @map("api_key")
  webhookSecret     String?             @map("webhook_secret")
  webhookUrl        String?             @map("webhook_url")
  isEnabled         Boolean             @default(false) @map("is_enabled")
  enabled           Boolean             @default(false)
  receiveOrders     Boolean             @default(true) @map("receive_orders")
  sendOrderStatus   Boolean             @default(false) @map("send_order_status")
  syncMenu          Boolean             @default(false) @map("sync_menu")
  syncProducts      Boolean             @default(false) @map("sync_products")
  syncPrices        Boolean             @default(false) @map("sync_prices")
  autoAcceptOrders  Boolean             @default(false) @map("auto_accept_orders")
  credentials       Json                @default("{}")
  settings          Json                @default("{}")
  config            Json                @default("{}")
  lastSyncAt        DateTime?           @map("last_sync_at") @db.Timestamptz(6)
  lastError         String?             @map("last_error")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productMaps       IntegrationProductMap[]
  paymentMaps       IntegrationPaymentMap[]
  orders            IntegrationOrder[]
  logs              IntegrationLog[]
  internalOrders    Order[]

  @@unique([restaurantId, provider])
  @@map("integrations")
}

model IntegrationProductMap {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String      @map("restaurant_id") @db.Uuid
  integrationId       String      @map("integration_id") @db.Uuid
  productId           String?     @map("product_id") @db.Uuid
  productVariantId    String?     @map("product_variant_id") @db.Uuid
  externalProductId   String      @map("external_product_id")
  externalProductName String?     @map("external_product_name")
  externalVariantId   String?     @map("external_variant_id")
  externalVariantName String?     @map("external_variant_name")
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  integration         Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalProductId, externalVariantId])
  @@map("integration_product_maps")
}

model IntegrationPaymentMap {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId          String      @map("restaurant_id") @db.Uuid
  integrationId         String      @map("integration_id") @db.Uuid
  externalPaymentCode   String      @map("external_payment_code")
  externalPaymentName   String?     @map("external_payment_name")
  internalPaymentMethod String      @map("internal_payment_method")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  integration           Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalPaymentCode])
  @@map("integration_payment_maps")
}

model IntegrationOrder {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String      @map("restaurant_id") @db.Uuid
  integrationId     String      @map("integration_id") @db.Uuid
  orderId           String?     @map("order_id") @db.Uuid
  externalOrderId   String      @map("external_order_id")
  externalCode      String?     @map("external_code")
  externalStatus    String?     @map("external_status")
  rawPayload        Json        @map("raw_payload")
  normalizedPayload Json?       @map("normalized_payload")
  importedAt        DateTime    @default(now()) @map("imported_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  integration       Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalOrderId])
  @@map("integration_orders")
}

model IntegrationLog {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String?              @map("restaurant_id") @db.Uuid
  integrationId   String?              @map("integration_id") @db.Uuid
  provider        IntegrationProvider?
  direction       String?
  eventType       String               @map("event_type")
  externalId      String?              @map("external_id")
  status          String
  message         String?
  payload         Json?
  requestHeaders  Json?                @map("request_headers")
  requestPayload  Json?                @map("request_payload")
  responsePayload Json?                @map("response_payload")
  errorMessage    String?              @map("error_message")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  integration     Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@map("integration_logs")
}

model OrderItem {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId    String           @map("restaurant_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  productId       String?          @map("product_id") @db.Uuid
  variantId       String?          @map("variant_id") @db.Uuid
  productName     String           @map("product_name")
  quantity        Int
  unitPrice       Decimal          @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal          @default(0) @map("total_price") @db.Decimal(12, 2)
  notes           String?
  selectedOptions Json             @default("{}") @map("selected_options")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  addons          OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String       @map("order_item_id") @db.Uuid
  addonId     String?      @map("addon_id") @db.Uuid
  name        String
  price       Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       ProductAddon? @relation(fields: [addonId], references: [id], onDelete: SetNull)

  @@map("order_item_addons")
}
